# ============================================================
# MedIntel Environment Template
# NEVER put real secrets in this file.
# Copy this file to .env for local development.
# ============================================================

# Authentication
# Generate real values only in local .env. Never commit them.
JWT_SECRET=REPLACE_WITH_RANDOM_SIGNING_SECRET
CLINICIAN_USERNAME=clinician
CLINICIAN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# ------------------------------------------------------------
# Local MedGemma Clinical Reasoning
# ------------------------------------------------------------

# Keep disabled unless the local llama-server endpoint is available.
AI_REASONING_ENABLED=false

AI_PROVIDER=local
PRIMARY_REASONING_MODEL=google/medgemma-1.5-4b-it
LOCAL_MEDGEMMA_MODEL_ID=google/medgemma-1.5-4b-it
MEDGEMMA_DEVICE=auto

# Host development:
MEDGEMMA_BASE_URL=http://127.0.0.1:8080

# Local GGUF path. Keep the real model outside Git.
# Example:
# MEDGEMMA_MODEL_PATH=C:/Dev/Models/MedGemma/medgemma-1.5-4b-it-q4_0.gguf
MEDGEMMA_MODEL_PATH=

# Provider behaviour
MEDGEMMA_TIMEOUT_SECONDS=120
MEDGEMMA_MAX_RETRIES=1

# Prompt / orchestration
REASONING_PROMPT_VERSION=clinical_reasoning_v1
REASONING_MAX_CANDIDATES=5
